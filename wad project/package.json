{
  "name": "fixnear-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FixNear - Find trusted local service professionals near you",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@fixnear/api\" \"npm run dev --workspace=@fixnear/web\"",
    "dev:api": "npm run dev --workspace=@fixnear/api",
    "dev:web": "npm run dev --workspace=@fixnear/web",
    "build": "npm run build --workspace=@fixnear/shared && npm run build --workspace=@fixnear/api && npm run build --workspace=@fixnear/web",
    "start": "npm run start --workspace=@fixnear/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
