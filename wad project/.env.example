# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fixnear_db?schema=public

# JWT Secrets
JWT_SECRET=fixnear_super_secure_jwt_access_secret_2026_x89f
JWT_REFRESH_SECRET=fixnear_super_secure_jwt_refresh_secret_2026_z12k
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Razorpay)
# For local development and testing, mock mode is automatically enabled if test keys are provided
RAZORPAY_KEY_ID=rzp_test_FixNearMockKeyId123
RAZORPAY_KEY_SECRET=FixNearMockSecretKey456

# Geocoding & Maps (Google Maps / Mapbox)
# If empty, OpenStreetMap/Leaflet is used out of the box with zero configuration
MAPS_API_KEY=

# File Storage (Cloudinary / S3)
CLOUDINARY_CLOUD_NAME=fixnear-demo
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=abcdef1234567890

# Email Service (Resend / Nodemailer)
EMAIL_API_KEY=
EMAIL_FROM=notifications@fixnear.dev
